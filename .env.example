# Copy this file to `.env` and fill in your real values. `.env` is gitignored.
# The clinic app loads `.env` automatically at startup (see clinic_app/config.py).

# Enables the Claude AI assistant (patient guidance + clinician briefings).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model (defaults to the smallest, claude-haiku-4-5).
# CLINIC_AI_MODEL=claude-haiku-4-5

# Optional: Flask session signing key (set a random string for real deployments).
# CLINIC_SECRET=change-me-to-a-random-string
